# GitHub fine-grained token for the AI Contributors monitor and repository publishing.
GITHUB_TOKEN=YOUR_FINE_GRAINED_TOKEN

# Optional production persistence. AI Countdown uses a separate collection
# in the project's Mongo database and falls back to JSON locally.
MONGO_URI=mongodb://127.0.0.1:3382/TDLib
AI_COUNTDOWN_MONGO_COLLECTION=ai_countdown_repository_analyses
AI_COUNTDOWN_CONTRIBUTOR_PROFILES_COLLECTION=ai_countdown_contributor_profiles
AI_COUNTDOWN_METRIC_SERIES_COLLECTION=ai_countdown_metric_series

# OpenRouter key and model for refresh-work-occupations.js (Work occupation ratings).
OPENROUTER_KEY=sk-or-your_key_here
WORK_MODEL=deepseek/deepseek-v4.1-flash
